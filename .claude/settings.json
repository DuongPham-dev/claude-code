{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/autofix-guard.sh\""
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "commit-to-pr",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-changes.sh\""
          }
        ]
      }
    ]
  }
}
